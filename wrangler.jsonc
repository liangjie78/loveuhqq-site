{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "loveuhqq-site",
  "account_id": "a8baff96e8cfcc965098997737826969",
  "compatibility_date": "2026-09-12",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "routes": [
    {
      "pattern": "loveuhqq.x23.shop",
      "custom_domain": true
    }
  ],
  "main": "worker/index.ts",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "loveuhqq-notebook",
      "database_id": "6b9b080a-b170-4b8c-8250-236b26cf1d0c",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
