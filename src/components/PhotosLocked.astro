---
import Icon from './Icon.astro';
import { LockKeyhole } from 'lucide';
import { photos } from '../content/copy';
---
<div class="lock-card photos-locked" data-photos-locked data-reveal>
  <p><Icon icon={LockKeyhole} size={18} /> {photos.locked}</p>
  <button class="btn btn-solid" type="button" data-open-login data-needs-js>{photos.unlock}</button>
  <noscript><p>{photos.noscript}</p></noscript>
</div>
