---
import type { Photo } from '../data/photos';
import { photoAriaLabel, photoStatusLabels } from '../data/photos';

interface Props {
  photo: Photo;
  index: number;
  /** Which cards get the pink tape — the caller owns that layout choice. */
  pink?: boolean;
}

const { photo, index, pink = false } = Astro.props;
---

<a class="polaroid" href={photo.src} data-photo-index={index} aria-label={photoAriaLabel(photo)}>
  <span class:list={['tape', pink && 'tape-pink']} aria-hidden="true"></span>
  <img src={photo.src} alt={photo.alt} width="800" height="1000" loading="lazy" decoding="async" />
  <span class="polaroid-caption">
    <span class="polaroid-title">{photo.title}</span>
    <span class="polaroid-tag">{photoStatusLabels[photo.status]}</span>
  </span>
</a>
