---
/** Blank, locked prints that hold the wall's shape until the private photos load. */
interface Props { count: number }
const { count } = Astro.props;
---

{Array.from({ length: count }, () => (
  <div class="polaroid polaroid-empty" aria-hidden="true">
    <span class="polaroid-slot"><span>待解锁</span></span>
    <span class="polaroid-caption"><span class="polaroid-title">&nbsp;</span></span>
  </div>
))}
