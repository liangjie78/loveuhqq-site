---
---
<div class="passphrase-backdrop" id="passphrase-gate">
  <div
    class="passphrase-card glass-panel"
    id="passphrase-card"
    role="dialog"
    aria-modal="true"
    aria-labelledby="gate-title"
    aria-describedby="gate-desc"
  >
    <p class="eyebrow">MEMO</p>
    <h2 id="gate-title">访问验证</h2>
    <p id="gate-desc" class="passphrase-tip">输入起始日期（如 0701）以继续浏览</p>

    <form class="passphrase-form" id="passphrase-form" autocomplete="off">
      <div class="passphrase-input-wrap">
        <input
          type="password"
          id="passphrase-input"
          class="passphrase-input"
          placeholder="输入日期..."
          required
          autocomplete="current-password"
          aria-label="访问暗号"
        />
        <button type="submit" class="passphrase-submit button button-primary">
          <span>进入</span>
        </button>
      </div>
      <p class="passphrase-error" id="passphrase-error" role="alert" hidden>输入不正确，请重试</p>
      <label class="passphrase-remember">
        <input type="checkbox" id="passphrase-remember" checked />
        <span>记住此设备</span>
      </label>
    </form>
  </div>
</div>
<script src="../scripts/passphrase-gate.ts"></script>
