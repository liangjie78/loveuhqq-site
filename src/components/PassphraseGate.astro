---
import Postmark from './Postmark.astro';
import { buttonVariants } from './ui/button';
import { inputVariants } from './ui/input';
---

<div class="gate" data-gate role="dialog" aria-modal="true" aria-labelledby="gate-title" aria-describedby="gate-hint">
  <div class="gate-card">
    <Postmark id="gate-mark" class="gate-postmark" dated={false} />
    <h2 class="gate-title" id="gate-title">我们，是从哪天开始的？</h2>
    <p class="gate-hint" id="gate-hint">月和日，四位数字</p>
    <form class="gate-form" data-gate-form novalidate>
      <label class="sr-only" for="gate-input">开始的日子，月和日共四位数字</label>
      <div class="gate-slots">
        <input
          class="gate-input"
          id="gate-input"
          data-gate-input
          type="text"
          inputmode="numeric"
          pattern="[0-9]*"
          maxlength="4"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
          enterkeyhint="go"
        />
        <span class="gate-group" data-label="月" aria-hidden="true"><span class="gate-slot" data-slot></span><span class="gate-slot" data-slot></span></span>
        <span class="gate-group" data-label="日" aria-hidden="true"><span class="gate-slot" data-slot></span><span class="gate-slot" data-slot></span></span>
      </div>
      <div class="gate-password" data-gate-password-panel hidden>
        <label for="editor-password">共同手账的密码</label>
        <input class={inputVariants({ variant: 'default' })} id="editor-password" data-gate-password type="password" autocomplete="current-password" maxlength="128" />
        <button class={buttonVariants({ variant: 'default' })} type="submit">解锁手账</button>
      </div>
      <p class="gate-error" data-gate-error role="alert"></p>
    </form>
    <button class:list={[buttonVariants({ variant: 'default' }), 'gate-retry']} type="button" data-gate-retry hidden>重试退出</button>
    <button class:list={[buttonVariants({ variant: 'ghost' }), 'gate-visit']} type="button" data-gate-visit>访客浏览</button>
  </div>
</div>
<script src="../scripts/passphrase-gate.ts"></script>
