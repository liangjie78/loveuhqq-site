---
import Icon from './Icon.astro';
import { ArrowLeft, ChevronDown, Check } from 'lucide';
import { common, site } from '../content/copy';

interface NavLink { href: string; label: string }
interface Props {
  /** In-page chapters; the home page and the memory book both have them. */
  links?: readonly NavLink[];
  /** Where the wordmark goes. */
  home?: string;
  /** Sub-pages link back to the journal. */
  backHref?: string;
  /** Only the home page lets you pick a signature from the header. */
  identity?: boolean;
  /** The home page shows the running day count once the cover is passed. */
  dayChip?: boolean;
  session?: boolean;
}

const { links = [], home = '/', backHref, identity = false, dayChip = false, session = true } = Astro.props;
---

<header class="masthead" data-header>
  <a class="wordmark" href={home} aria-label={site.name}>
    <span class="latin" aria-hidden="true">loveuhqq</span><span class="wordmark-mark" aria-hidden="true"></span>
  </a>

  {links.length > 0 && (
    <nav class="pillnav" aria-label={common.pageNav} data-pillnav>
      <span class="pillnav-glow" aria-hidden="true" data-pillnav-glow></span>
      {links.map(({ href, label }) => <a href={href} data-nav-link>{label}</a>)}
    </nav>
  )}

  <div class="masthead-tools">
    {dayChip && (
      <p class="day-chip" data-header-day hidden>第 <span class="numeral" data-day-count></span> 天</p>
    )}
    <button class="icon-btn theme-toggle" type="button" data-theme-toggle aria-label={common.themeToDark} title={common.themeToDark}>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
        <mask id="theme-mask"><rect width="24" height="24" fill="#fff"></rect><circle class="theme-bite" cx="19" cy="5" r="7" fill="#000"></circle></mask>
        <circle class="theme-core" cx="12" cy="12" r="5" fill="currentColor" stroke="none" mask="url(#theme-mask)"></circle>
        <g class="theme-rays">
          <path d="M12 2.5v1.8M12 19.7v1.8M4.6 4.6l1.3 1.3M18.1 18.1l1.3 1.3M2.5 12h1.8M19.7 12h1.8M4.6 19.4l1.3-1.3M18.1 5.9l1.3-1.3"></path>
        </g>
      </svg>
    </button>
    {session && (
      <div class="session" data-header-session>
        <button class="btn btn-quiet btn-sm" type="button" data-open-login data-needs-js aria-label={common.guestLabel}>{common.guest}</button>
        <span class="session-label" data-session-label hidden>
          {identity ? (
            <span class="identity" data-identity hidden>
              <button class="identity-trigger" type="button" data-identity-trigger aria-expanded="false" aria-label="请选择身份">
                <span data-identity-name>选择身份</span><Icon icon={ChevronDown} size={14} />
              </button>
              <span class="identity-menu" data-identity-menu hidden role="group" aria-label="请选择身份">
                <button type="button" class="identity-option" data-identity-option="one" aria-pressed="false">男生<Icon icon={Check} size={14} /></button>
                <button type="button" class="identity-option" data-identity-option="two" aria-pressed="false">女生<Icon icon={Check} size={14} /></button>
                <span class="identity-status" role="status" data-identity-status></span>
              </span>
            </span>
          ) : <span class="session-note">{common.ourJournal}</span>}
        </span>
        <button class="btn btn-quiet btn-sm" type="button" data-session-logout hidden>{common.logout}</button>
        <noscript><span class="session-note">{common.guest}</span></noscript>
      </div>
    )}
    {backHref && (
      <a class="btn btn-sm back-link" href={backHref}><Icon icon={ArrowLeft} size={15} class="icon-back" /> <span class="back-label">{common.backToJournal}</span></a>
    )}
    {links.length > 0 && (
      <button class="icon-btn menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="menu-sheet" aria-label={common.pageNav}>
        <span class="menu-bars" aria-hidden="true"><span></span><span></span></span>
      </button>
    )}
  </div>
</header>

{links.length > 0 && (
  <div class="menu-sheet" id="menu-sheet" data-menu hidden>
    <nav aria-label={common.pageNav}>
      <ol>
        {links.map(({ href, label }, index) => (
          <li style={`--i:${index}`}>
            <a href={href} data-menu-link><span class="numeral">{String(index + 1).padStart(2, '0')}</span><span class="serif">{label}</span></a>
          </li>
        ))}
      </ol>
    </nav>
    {backHref && <a class="link menu-back" href={backHref}><Icon icon={ArrowLeft} size={15} /> {common.backToJournal}</a>}
  </div>
)}
