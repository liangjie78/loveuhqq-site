---
import { buttonVariants } from './ui/button';
import { inputVariants } from './ui/input';
import { Sparkles } from 'lucide-react';
---

<section class="section future" id="future" aria-labelledby="future-title">
  <div class="section-inner future-spread">
    <header class="future-intro" data-reveal>
      <h2 id="future-title">往后的日子<br />也想和你一起</h2>
      <p>想到一件就写下来。<br />不用着急，一件一件来。</p>
      <button class:list={[buttonVariants({ variant: 'ghost' }), 'draw-button']} type="button" data-wish-draw data-needs-js hidden><Sparkles size={16} aria-hidden="true" /> 从清单里抽一件</button>
      <p class="draw-result" data-wish-result role="status" data-needs-js hidden></p>
    </header>
    <div class="future-paper" data-reveal>
      <span class="tape tape-corner" aria-hidden="true"></span>
      <div class="future-paper-head"><h3>往后的小清单</h3><span data-wish-count data-needs-js hidden>还空着</span></div>
      <div class="notebook-guest" data-wish-guest>
        <p>解锁后，翻看我们的记录</p>
        <button class={buttonVariants({ variant: 'default' })} type="button" data-open-login data-needs-js>解锁手账</button>
      </div>
      <div class="notebook-loading" data-wish-loading hidden>
        <p data-wish-loading-status role="status">正在打开手账…</p>
        <button class={buttonVariants({ variant: 'ghost' })} type="button" data-wish-retry hidden>重新连接</button>
      </div>
      <div data-wish-private hidden>
        <p class="wish-empty" data-wish-empty>第一件，留给我们自己写。</p>
        <ul class="wish-list" data-wish-list></ul>
        <form class="wish-form" data-wish-form>
          <label class="sr-only" for="wish-text">想一起做的小事</label>
          <input class={inputVariants({ variant: 'underline' })} id="wish-text" type="text" maxlength="120" required placeholder="写下一件想一起做的事" autocomplete="off" />
          <button class={buttonVariants({ variant: 'default' })} type="submit">记上</button>
        </form>
        <p class="notebook-status" data-wish-status role="status"></p>
        <button class={buttonVariants({ variant: 'ghost' })} type="button" data-wish-refresh hidden>刷新查看</button>
        <button class={buttonVariants({ variant: 'ghost' })} type="button" data-wish-undo hidden>撤销刚才的移除</button>
      </div>
      <noscript><p class="paper-local">开启 JavaScript 后，可以解锁共同手账。</p></noscript>
    </div>
    <div class="notebook-tools" data-wish-private hidden>
      <p>写进手账里，换个地方也能接着看。</p>
    </div>
  </div>
</section>
