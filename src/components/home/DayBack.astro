---
import Icon from '../Icon.astro';
import { ArrowUpRight, BookOpen, RefreshCw, Search } from 'lucide';
import { common } from '../../content/copy';
---

<section class="dayback" id="dayback" aria-label="日子的背面" tabindex="-1" data-needs-js data-reveal>
  <div class="dayback-guest" data-note-guest>
    <p class="eyebrow is-bare">日子的背面</p>
    <p class="dayback-guest-copy serif">解锁后，翻看我们的记录</p>
    <button class="btn btn-solid" type="button" data-open-login data-needs-js>{common.unlock}</button>
  </div>
  <div class="dayback-loading" data-note-loading hidden>
    <p data-note-loading-status role="status">正在打开手账…</p>
    <button class="btn btn-sm" type="button" data-note-retry hidden>重新连接</button>
  </div>
  <div class="dayback-private" data-note-private hidden>
    <header class="dayback-head">
      <div>
        <p class="eyebrow is-bare">日子的背面</p>
        <h3 class="dayback-date numeral" id="day-back-title" data-note-date tabindex="-1">给今天留一句</h3>
      </div>
      <button class="btn btn-solid" type="button" data-note-edit><span data-note-edit-label>写一句</span></button>
    </header>
    <aside class="prompt" data-daily-prompt aria-label="写作灵感">
      <svg class="prompt-flower" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
        <circle cx="20" cy="20" r="3.2"></circle>
        <path d="M20 16.8c-3.5-6 3.5-8.5 3.4-2.2 5.2-3 8 3.4 1.7 4.8 5 4.4-.6 9.5-4.2 3.7-2.6 6.3-9.3 2.6-5.1-2.5-6.4-1-5.2-7.6.5-5.6.1-6.2 7-5.8 3.7 1.8Z"></path>
      </svg>
      <p class="prompt-question serif" data-daily-prompt-question aria-live="polite" aria-atomic="true">这一天有什么小事，想留在这一页？</p>
      <button class="btn btn-sm btn-quiet" type="button" data-daily-prompt-next>换个话头 <Icon icon={RefreshCw} size={14} /></button>
    </aside>
    <p class="dayback-text" data-note-text>这一天还空着。想记的时候，再写。</p>
    <a class="link dayback-stories" data-date-stories href="/memories/">翻看这一天的故事 <Icon icon={ArrowUpRight} size={15} /></a>
    <form data-note-form hidden class="dayback-editor">
      <label class="sr-only" for="day-note">这一天想记下的话</label>
      <textarea class="textarea dayback-textarea" id="day-note" maxlength="2000" rows="4" placeholder="写在这里。"></textarea>
      <div class="row-actions">
        <button class="btn btn-solid" type="submit">收好这一句</button>
        <button class="btn" type="button" data-note-cancel>取消</button>
        <button class="btn btn-danger" type="button" data-note-delete hidden>移除这一句</button>
      </div>
    </form>
    <div class="notice" data-note-conflict hidden>
      <p>这一天在手账里有新内容。草稿还在，可以先刷新对照。</p>
      <button class="btn btn-sm" type="button" data-note-refresh>刷新查看</button>
      <p class="notice-latest" data-note-latest hidden></p>
    </div>
    <p class="status-line" data-note-status role="status"></p>
    <button class="btn btn-sm" type="button" data-note-undo hidden>撤销移除这一句</button>

    <div class="dayback-foot">
      <div class="bookmark">
        <Icon icon={BookOpen} size={20} class="bookmark-icon" />
        <div><h4>随手翻一页</h4><p class="meta" data-note-random-hint>从写过的日子里，挑一天回看。</p></div>
        <button class="btn btn-sm" type="button" data-note-random disabled>翻一页</button>
      </div>
      <details class="note-index" data-note-index>
        <summary><span>翻看写过的日子</span> <span class="numeral note-index-count" data-notes-count>0</span></summary>
        <div class="note-search">
          <label class="field-label meta" for="note-search">按日期或一句话找找</label>
          <div class="note-search-field">
            <Icon icon={Search} size={16} class="note-search-icon" />
            <input class="input" id="note-search" type="search" maxlength="120" placeholder="比如 10月，或记得的几个字" autocomplete="off" />
            <button class="btn btn-sm btn-quiet" type="button" data-note-search-clear hidden>清空</button>
          </div>
        </div>
        <p class="meta" data-notes-empty role="status" hidden></p>
        <div class="note-list" data-notes-list data-lenis-prevent></div>
      </details>
    </div>
  </div>
</section>
