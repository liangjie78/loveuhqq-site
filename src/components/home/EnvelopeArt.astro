---
/**
 * The hundred-day envelope, cut from a real photograph so the paper and wax
 * stay real: the pocket stays, the flap (with the top of the seal) swings open,
 * warm light spills out and the letter rises from inside.
 */
---
<span class="envelope-tilt" aria-hidden="true">
  <span class="envelope-shadow"></span>
  <span class="envelope-body">
    <span class="env-back"></span>
    <span class="env-glow"></span>
    <span class="env-letter">
      <span class="env-letter-head">写给第 <i>100</i> 天</span>
      <span class="env-letter-lines"></span>
    </span>
    <span class="env-pocket"></span>
    <span class="env-flap">
      <span class="env-flap-face is-outer"></span>
      <span class="env-flap-face is-inner"></span>
    </span>
  </span>
</span>
