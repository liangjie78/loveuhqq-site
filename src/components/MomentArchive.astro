---
import { dotted, relationshipStartDate } from '../lib/anniversary';
import { moments } from '../data/moments';

const entries = new Map(moments.map(({ date, title }) => [date, title]));
entries.set(relationshipStartDate, entries.get(relationshipStartDate) ?? '第一天');
const timeline = [...entries]
  .map(([date, title]) => ({ date, title }))
  .sort((left, right) => left.date.localeCompare(right.date));
---

<section class="moment-archive" aria-labelledby="moments-title">
  <header class="moment-archive-head">
    <h3 id="moments-title">记下的日子</h3>
  </header>
  <ol class="moment-archive-list">
    {timeline.map(({ date, title }) => (
      <li class="memory-ticket">
        <button class="memory-ticket-button" type="button" data-moment-ticket data-moment-ticket-date={date} aria-label={`${dotted(date)}，${title}`}>
          <time data-moment-date datetime={date}>{dotted(date)}</time>
          <span class="memory-ticket-title">{title}</span>
          <span data-moment-status hidden>还没到</span>
        </button>
      </li>
    ))}
  </ol>
</section>
