---
import SiteSession from '../islands/SiteSession';
import { ArrowLeft } from 'lucide-react';

interface NavLink {
  href: string;
  label: string;
}

interface Props {
  /** The home page shows in-page links; other pages link back to it. */
  home?: boolean;
  /** Custom navigation links for page-internal navigation (like memories). */
  navLinks?: NavLink[];
  /** Where a sub-page's back link lands on the home page. */
  backHref?: string;
}

const { home = false, navLinks, backHref = '/#photos' } = Astro.props;
const defaultHomeLinks: NavLink[] = [
  { href: '#days', label: '日子' },
  { href: '#photos', label: '照片' },
  { href: '#note', label: '心里话' },
  { href: '#future', label: '往后' },
  { href: '#letter', label: '信' },
];
const effectiveLinks = navLinks ?? (home ? defaultHomeLinks : []);
const hasNav = effectiveLinks.length > 0;
---

<header class:list={['site-header', !home && 'is-solid']} data-header>
  <a class="wordmark" href={home ? '#top' : '/'}>loveuhqq<span class="wordmark-heart" aria-hidden="true"></span></a>
  {
    hasNav && (
      <nav class="site-nav" aria-label="页内导航">
        {effectiveLinks.map(({ href, label }) => <a href={href} aria-current={href === Astro.url.pathname ? 'page' : undefined}>{label}</a>)}
      </nav>
    )
  }
  {
    home ? (
      <>
        <p class="header-day" data-header-day hidden>
          第 <span data-day-count /> 天
        </p>
        <div class="header-guest ui" data-header-session>
          <SiteSession client:load />
          <noscript>访客</noscript>
        </div>
      </>
    ) : (
      <div class="header-actions">
        <div class="header-guest ui" data-header-session>
          <SiteSession client:load />
          <noscript>访客</noscript>
        </div>
        <a class="back-link" href={backHref}>
          <ArrowLeft size={15} aria-hidden="true" /> 回到日记
        </a>
      </div>
    )
  }
</header>
<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const updateHeaderSurface = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
    updateHeaderSurface();
    window.addEventListener('scroll', updateHeaderSurface, { passive: true });
  }
</script>
