---
interface Props {
  /** The home page shows in-page links; other pages link back to it. */
  home?: boolean;
}

const { home = false } = Astro.props;
const links = [
  { href: '#days', label: '日子' },
  { href: '#photos', label: '照片' },
  { href: '#note', label: '心里话' },
  { href: '#future', label: '往后' },
  { href: '#letter', label: '信' },
];
---

<header class:list={['site-header', !home && 'is-solid']} data-header>
  <a class="wordmark" href={home ? '#top' : '/'}>loveuhqq<span class="wordmark-heart" aria-hidden="true"></span></a>
  {
    home ? (
      <>
        <nav class="site-nav" aria-label="页内导航">
          {links.map(({ href, label }) => <a href={href}>{label}</a>)}
        </nav>
        <p class="header-day" data-header-day hidden>
          第 <span data-day-count /> 天
        </p>
        <div class="header-guest" data-header-session>
          <button type="button" class="text-button" data-open-login data-needs-js aria-label="访客，点击解锁共同手账">访客</button>
          <noscript>访客</noscript>
          <span data-session-label hidden>我们的手账</span>
          <button type="button" class="text-button" data-session-logout hidden>退出</button>
        </div>
      </>
    ) : (
      <a class="back-link" href="/#photos">
        <span aria-hidden="true">←</span> 回到日记
      </a>
    )
  }
</header>

<section class="signature-choice" data-signature-choice hidden aria-label="选择身份">
  <span data-signature-label>请选择身份</span>
  <button type="button" class="text-button" data-signature="one" aria-pressed="false">男生</button>
  <button type="button" class="text-button" data-signature="two" aria-pressed="false">女生</button>
  <span data-signature-status role="status"></span>
</section>
<script src="../scripts/signature-choice.ts"></script>
