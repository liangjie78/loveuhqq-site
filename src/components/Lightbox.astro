---
import { buttonVariants } from './ui/button';
import { ArrowUpRight, ChevronLeft, ChevronRight, X } from 'lucide-react';
---

<dialog class="lightbox" data-lightbox aria-labelledby="lightbox-title">
  <figure class="lightbox-print">
    <img data-lightbox-image alt="" width="800" height="1000" />
    <figcaption>
      <span class="lightbox-title" id="lightbox-title" data-lightbox-title></span>
      <span class="lightbox-meta" data-lightbox-meta aria-live="polite"></span>
      <a class={buttonVariants({ variant: 'ghost' })} data-photo-stories hidden>翻到照片里的故事 <ArrowUpRight size={16} aria-hidden="true" /></a>
    </figcaption>
    <p class="lightbox-feedback" data-lightbox-feedback hidden>
      <span data-lightbox-status role="status"></span>
      <button class={buttonVariants({ variant: 'ghost' })} type="button" data-lightbox-retry hidden>再试一次</button>
    </p>
    <div class="photo-management lightbox-management" data-lightbox-management hidden>
      <button class={buttonVariants({ variant: 'ghost' })} type="button" data-lightbox-edit>改标题</button>
      <button class={buttonVariants({ variant: 'ghost' })} type="button" data-lightbox-feature>设为首页精选</button>
      <button class={buttonVariants({ variant: 'ghost', tone: 'danger' })} type="button" data-lightbox-delete>从相册取下</button>
    </div>
  </figure>
  <button class="lightbox-button lightbox-close" type="button" data-lightbox-close aria-label="关闭">
    <X size={20} aria-hidden="true" />
  </button>
  <button class="lightbox-button lightbox-prev" type="button" data-lightbox-prev aria-label="上一张">
    <ChevronLeft size={24} aria-hidden="true" />
  </button>
  <button class="lightbox-button lightbox-next" type="button" data-lightbox-next aria-label="下一张">
    <ChevronRight size={24} aria-hidden="true" />
  </button>
</dialog>
<script src="../scripts/gallery.ts"></script>
