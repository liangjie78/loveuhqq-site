---
import Icon from './Icon.astro';
import { ArrowUpRight, ChevronLeft, ChevronRight, Pencil, Star, Trash2, X } from 'lucide';
---
<dialog class="lightbox" data-lightbox aria-labelledby="lightbox-title">
  <div class="lightbox-stage">
    <figure class="lightbox-print">
      <div class="lightbox-frame"><img data-lightbox-image alt="" width="800" height="1000" /></div>
      <figcaption class="lightbox-caption">
        <span class="lightbox-title" id="lightbox-title" data-lightbox-title></span>
        <span class="lightbox-meta numeral" data-lightbox-meta aria-live="polite"></span>
        <a class="link lightbox-story" data-photo-stories hidden>翻到照片里的故事 <Icon icon={ArrowUpRight} size={15} /></a>
      </figcaption>
      <p class="lightbox-feedback" data-lightbox-feedback hidden>
        <span data-lightbox-status role="status"></span>
        <button class="btn btn-sm" type="button" data-lightbox-retry hidden>再试一次</button>
      </p>
      <div class="lightbox-manage" data-lightbox-management hidden>
        <button class="btn btn-sm" type="button" data-lightbox-edit><Icon icon={Pencil} size={14} /> 改标题</button>
        <button class="btn btn-sm" type="button" data-lightbox-feature><Icon icon={Star} size={14} /> <span data-lightbox-feature-label>设为首页精选</span></button>
        <button class="btn btn-sm btn-danger" type="button" data-lightbox-delete><Icon icon={Trash2} size={14} /> 从相册取下</button>
      </div>
    </figure>
  </div>
  <button class="icon-btn lightbox-close" type="button" data-lightbox-close aria-label="关闭"><Icon icon={X} size={20} /></button>
  <button class="icon-btn lightbox-step lightbox-prev" type="button" data-lightbox-prev aria-label="上一张"><Icon icon={ChevronLeft} size={22} /></button>
  <button class="icon-btn lightbox-step lightbox-next" type="button" data-lightbox-next aria-label="下一张"><Icon icon={ChevronRight} size={22} /></button>
</dialog>
