<dialog class="lightbox" data-lightbox aria-labelledby="lightbox-title">
  <figure class="lightbox-print">
    <img data-lightbox-image alt="" width="800" height="1000" />
    <figcaption>
      <span class="lightbox-title" id="lightbox-title" data-lightbox-title></span>
      <span class="lightbox-meta" data-lightbox-meta aria-live="polite"></span>
    </figcaption>
    <div class="photo-management lightbox-management" data-lightbox-management hidden>
      <button class="text-button" type="button" data-lightbox-edit>改标题</button>
      <button class="text-button" type="button" data-lightbox-feature>设为首页精选</button>
      <button class="text-button photo-remove-button" type="button" data-lightbox-delete>从相册取下</button>
    </div>
  </figure>
  <button class="lightbox-button lightbox-close" type="button" data-lightbox-close aria-label="关闭">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
  </button>
  <button class="lightbox-button lightbox-prev" type="button" data-lightbox-prev aria-label="上一张">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
  </button>
  <button class="lightbox-button lightbox-next" type="button" data-lightbox-next aria-label="下一张">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
  </button>
</dialog>
<script src="../scripts/gallery.ts"></script>
