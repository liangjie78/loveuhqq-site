---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/chrome.css';
import Gate from '../components/Gate.astro';
import { site } from '../content/copy';
import serifUrl from '../assets/fonts/noto-serif-sc-subset.woff2?url';
import latinItalicUrl from '../assets/fonts/instrument-serif-italic.woff2?url';

interface Props {
  title: string;
  description: string;
  path: string;
  page: 'home' | 'album' | 'memories' | 'lost';
}

const { title, description, path, page } = Astro.props;
const url = new URL(path, Astro.site).href;
const image = new URL('/images/og-yuwen.png', Astro.site).href;
---

<!doctype html>
<html lang="zh-CN" data-page={page}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Private site: noindex is deliberate (robots.txt matches); OG tags only feed chat-app share previews. -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f6f0e8" />
    <link rel="canonical" href={url} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="preload" href={serifUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={latinItalicUrl} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('has-js');
        var theme = 'light';
        try { theme = localStorage.getItem('loveuhqq_theme') === 'dark' ? 'dark' : 'light'; } catch (error) { /* Theme storage is optional. */ }
        root.classList.toggle('dark', theme === 'dark');
        root.dataset.theme = theme;
        document.querySelector('meta[name="color-scheme"]')?.setAttribute('content', theme);
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#110d0c' : '#f6f0e8');
        var calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!calm && 'IntersectionObserver' in window) {
          root.classList.add('can-reveal');
          setTimeout(function () {
            if (!root.classList.contains('reveal-ready')) root.classList.remove('can-reveal');
          }, 3000);
        }
        var logoutUnconfirmed = false;
        try { logoutUnconfirmed = sessionStorage.getItem('loveuhqq_logout_unconfirmed') === 'yes'; } catch (error) { /* Storage is optional. */ }
        try { logoutUnconfirmed = logoutUnconfirmed || localStorage.getItem('loveuhqq_logout_unconfirmed') === 'yes'; } catch (error) { /* Storage is optional. */ }
        try {
          if (logoutUnconfirmed || sessionStorage.getItem('loveuhqq_visited') !== 'yes') root.classList.add('is-locked');
        } catch (error) {
          root.classList.add('is-locked');
        }
        // Fail-safe: if the gate bundle never runs, never leave the page behind a lock nobody can open.
        setTimeout(function () {
          if (!logoutUnconfirmed && !root.classList.contains('gate-ready')) root.classList.remove('is-locked');
        }, 3000);
        // Hold the opening until both serifs are in, so the title never swaps faces mid-way.
        if (document.fonts && document.fonts.load) {
          root.classList.add('fonts-pending');
          var ready = function () {
            if (!root.classList.contains('fonts-pending')) return;
            root.classList.remove('fonts-pending');
            document.dispatchEvent(new Event('fonts:ready'));
          };
          setTimeout(ready, 1500);
          document.addEventListener('DOMContentLoaded', function () {
            Promise.all([
              document.fonts.load('300 1em "Noto Serif SC"'),
              document.fonts.load('italic 400 1em "Instrument Serif"'),
            ]).then(ready, ready);
          });
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{site.skip}</a>
    <slot />
    <Gate />
    <div class="grain" aria-hidden="true"></div>
    <div class="lamp" aria-hidden="true" data-lamp></div>
    <script src="../app/site.ts"></script>
  </body>
</html>
