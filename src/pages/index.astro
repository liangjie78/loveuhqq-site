---
import { relationshipStartDate, hundredthDayDate } from '../lib/anniversary';
import { photos } from '../data/photos';
import '../styles/global.css';

const startDateLabel = relationshipStartDate.replaceAll('-', '.');
const hundredthDayLabel = hundredthDayDate.replaceAll('-', '.');
const chapters = [
  { id: 'home', label: '首页' },
  { id: 'story', label: '故事' },
  { id: 'photos', label: '照片' },
  { id: 'letter', label: '心里话' },
  { id: 'anniversary', label: '纪念日' },
  { id: 'future', label: '未来' },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={'爱你，何青青。把平凡的日子，慢慢写成我们的故事。始于 ' + startDateLabel + '。'} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f8edf1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>爱你，何青青。 · loveuhqq</title>
  </head>
  <body>
    <a class="skip-link" href="#home">跳到正文</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="wordmark" href="#home" aria-label="loveuhqq 首页"><span class="brand-mark" aria-hidden="true">lq.</span><span>loveuhqq</span></a>
        <button class="menu-toggle" type="button" aria-label="打开导航" aria-expanded="false" aria-controls="site-nav" hidden><span></span><span></span></button>
        <nav id="site-nav" aria-label="主导航">
          {chapters.map(({ id, label }) => <a href={'#' + id} aria-current={id === 'home' ? 'location' : undefined}>{label}</a>)}
        </nav>
        <a class="header-date" href="#anniversary">始于 <time datetime={relationshipStartDate}>{startDateLabel}</time><span aria-hidden="true">↗</span></a>
      </div>
    </header>
    <nav class="chapter-nav" aria-label="章节导航">
      {chapters.map(({ id, label }, index) => <a href={'#' + id} aria-label={'第 ' + (index + 1) + ' 屏：' + label} aria-current={id === 'home' ? 'location' : undefined}><span class="chapter-tooltip">{label}</span><span class="chapter-dot"></span></a>)}
    </nav>
    <main id="main">
      <section class="chapter hero" id="home" aria-labelledby="letter-title" tabindex="-1">
        <div class="chapter-inner hero-layout">
          <div class="hero-copy" data-reveal>
            <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span>FOR YOU, ALWAYS</p>
            <h1 id="letter-title">爱你，<br /><span>何青青。</span></h1>
            <p class="intro">把平凡的日子，<br />慢慢写成我们的故事。</p>
            <a class="button button-primary" href="#story">往下看我们的故事 <span aria-hidden="true">↗</span></a>
          </div>
          <div class="hero-visual" data-reveal>
            <img class="paper-heart" src="/images/paper-heart.webp" alt="" width="900" height="900" decoding="async" />
            <div class="relationship glass-panel">
              <div class="day-counter" data-anniversary-count hidden><p>我们在一起的第</p><p><strong data-anniversary-day></strong><span class="day-unit">天</span></p></div>
              <p class="date">始于 <time datetime={relationshipStartDate}>{startDateLabel}</time></p>
              <span class="counter-line" aria-hidden="true"></span><p class="counter-note">时光很慢，而我们正好。</p>
            </div>
          </div>
        </div>
        <div class="chapter-bottom"><p><span class="chapter-count">01 / 06</span><span class="bottom-note">平凡的日子里，藏着最珍贵的小小幸福。</span></p><a class="scroll-cue" href="#story">向下，慢慢看 <span aria-hidden="true">↓</span></a></div>
      </section>

      <section class="chapter story-section" id="story" aria-labelledby="story-title" tabindex="-1">
        <div class="chapter-inner split-layout">
          <div class="section-copy" data-reveal>
            <p class="eyebrow">01 — OUR STORY</p><h2 id="story-title">我们的<br /><span class="accent">故事。</span></h2>
            <p class="section-description">好的故事，总是从平凡的某一天<br class="desktop-break" />悄悄开始。</p>
            <ol class="timeline">
              <li><time datetime={relationshipStartDate}>{startDateLabel}</time><h3>故事开始的那一天</h3><p>把平凡的日子，慢慢写成我们的故事。</p></li>
              <li class="timeline-next"><span>待续</span><p>下一段故事，等我们一起写。</p></li>
            </ol>
          </div>
          <div class="story-visual" data-reveal>
            <div class="memory-frame"><div class="empty-photo"><svg viewBox="0 0 48 48" fill="none" aria-hidden="true"><rect x="7" y="9" width="34" height="30" rx="4" /><circle cx="31" cy="19" r="3" /><path d="m8 34 10-12 9 10 5-5 8 9" /></svg><p>留给我们的第一张照片</p></div><div class="frame-caption"><span>故事，从这里开始。</span><span aria-hidden="true">♡</span></div></div>
            <span class="frame-orbit" aria-hidden="true"></span>
          </div>
        </div>
        <div class="chapter-bottom"><p><span class="chapter-count">02 / 06</span><span class="bottom-note">OUR STORY</span></p><a class="scroll-cue" href="#photos">留住一些瞬间 <span aria-hidden="true">↓</span></a></div>
      </section>

      <section class="chapter photo-section" id="photos" aria-labelledby="photos-title" tabindex="-1">
        <div class="chapter-inner photos-content">
          <header class="photos-heading" data-reveal><div><p class="eyebrow">02 — LITTLE MOMENTS</p><h2 id="photos-title">一些值得<br /><span class="accent">留下来的瞬间。</span></h2></div><p class="section-description">每一张照片，都是时光<br />送给我们的温柔礼物。</p></header>
          <div class="photo-grid" data-reveal>
            {photos.map((photo, index) => <a class="photo-card" href={photo.src} data-photo-index={index} aria-label={'查看' + photo.title + '（示意图片）'}><img src={photo.src} alt={photo.alt} width="800" height="1000" loading="lazy" decoding="async" /><span class="photo-badge">示意图片</span><div class="photo-card-caption"><div><span class="photo-number">0{index + 1}</span><h3>{photo.title}</h3></div><span class="photo-expand" aria-hidden="true">↗</span></div></a>)}
          </div>
          <div class="gallery-caption"><p class="quiet-note">示意相册 · 等待放入我们的照片</p><div class="gallery-actions"><button class="text-link" type="button" data-open-gallery hidden>翻开相册 <span aria-hidden="true">↗</span></button><a class="text-link" href="/photos/">点击进入更多照片 <span aria-hidden="true">↗</span></a></div></div>
        </div>
        <div class="chapter-bottom"><p><span class="chapter-count">03 / 06</span><span class="bottom-note">LITTLE MOMENTS</span></p><a class="scroll-cue" href="#letter">今天想对你说 <span aria-hidden="true">↓</span></a></div>
      </section>

      <section class="chapter message-section" id="letter" aria-labelledby="message-title" tabindex="-1">
        <div class="chapter-inner letter-content" data-reveal>
          <p class="eyebrow">03 — A LITTLE NOTE</p><h2 id="message-title" class="small-heading">今天想对你说</h2>
          <div class="letter-placeholder"><span aria-hidden="true">♡</span><p>文案待填写</p></div>
        </div>
        <div class="chapter-bottom"><p><span class="chapter-count">04 / 06</span><span class="bottom-note">A LITTLE NOTE</span></p><a class="scroll-cue" href="#anniversary">期待下一个纪念日 <span aria-hidden="true">↓</span></a></div>
      </section>

      <section class="chapter anniversary-section" id="anniversary" aria-labelledby="anniversary-title" tabindex="-1">
        <div class="chapter-inner split-layout">
          <div class="section-copy" data-reveal><p class="eyebrow">04 — DAYS TO REMEMBER</p><h2 id="anniversary-title"><span data-milestone-heading>值得记住</span><span data-milestone-ending>的日子。</span></h2><p class="section-description">在平凡的日子里，一直爱下去。</p><p class="anniversary-start">始于 <time datetime={relationshipStartDate}>{startDateLabel}</time></p></div>
          <div class="milestone glass-panel" data-reveal><div class="milestone-top"><p class="milestone-title" data-milestone-title>第 100 天</p><span class="status-dot" aria-hidden="true"></span></div><time class="milestone-date" data-milestone-date datetime={hundredthDayDate}>{hundredthDayLabel}</time><div class="countdown" data-milestone-count hidden><span data-milestone-prefix>还有</span><p><strong data-milestone-days></strong><span class="countdown-unit" data-milestone-suffix>天</span></p></div><p class="quiet-note" data-date-fallback>始于 {startDateLabel}，期待每一个纪念日。</p><div class="milestone-bottom"><span aria-hidden="true">♡</span><p>时光很慢，而我们正好。</p></div></div>
        </div>
        <div class="chapter-bottom"><p><span class="chapter-count">05 / 06</span><span class="bottom-note">DAYS TO REMEMBER</span></p><a class="scroll-cue" href="#future">写给未来 <span aria-hidden="true">↓</span></a></div>
      </section>

      <section class="chapter future-section" id="future" aria-labelledby="future-title" tabindex="-1">
        <div class="chapter-inner future-content">
          <div class="future-copy" data-reveal><p class="eyebrow">05 — TO BE CONTINUED</p><h2 id="future-title">写给未来。<br /><span class="accent">未完待续……</span></h2><p class="section-description">愿未来的我们，依然温柔相爱。</p><a class="button button-secondary" href="#home">回到故事的开始 <span aria-hidden="true">↑</span></a></div>
          <div class="future-letter" data-reveal><img src="/images/envelope.webp" alt="" width="800" height="1000" loading="lazy" decoding="async" aria-hidden="true" /><div class="future-caption"><p class="pill-label">信件待写</p><h3>写给第 100 天的我们</h3><p class="date">纪念日 <time datetime={hundredthDayDate}>{hundredthDayLabel}</time></p></div></div>
        </div>
        <footer class="site-footer"><a class="wordmark" href="#home" aria-label="loveuhqq 回到首页">loveuhqq<span class="footer-heart" aria-hidden="true">♡</span></a><p>把平凡的日子，慢慢写成我们的故事。</p><a class="footer-top" href="#home">回到顶部 <span aria-hidden="true">↑</span></a><span class="chapter-count">06 / 06</span></footer>
      </section>
    </main>

    <dialog class="photo-dialog" aria-labelledby="gallery-title" aria-describedby="gallery-description">
      <div class="dialog-header"><div><p class="eyebrow">LITTLE MOMENTS</p><h2 id="gallery-title">示意相册</h2></div><button class="close-gallery icon-button" type="button" aria-label="关闭相册"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg></button></div>
      <div class="dialog-body"><img data-gallery-image alt="" width="800" height="1000" /><p id="gallery-description">这些是示意图片，留待换成我们的照片。</p></div>
      <div class="dialog-footer"><button class="icon-button" type="button" data-gallery-previous aria-label="上一张图片">←</button><p data-gallery-caption aria-live="polite" aria-atomic="true"></p><button class="icon-button" type="button" data-gallery-next aria-label="下一张图片">→</button></div>
    </dialog>
    <script src="../scripts/keepsake.ts"></script>
  </body>
</html>
