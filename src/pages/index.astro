---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Cover from '../components/home/Cover.astro';
import Days from '../components/home/Days.astro';
import Photos from '../components/home/Photos.astro';
import Note from '../components/home/Note.astro';
import Future from '../components/home/Future.astro';
import MemoryEntry from '../components/home/MemoryEntry.astro';
import Letter from '../components/home/Letter.astro';
import Lightbox from '../components/Lightbox.astro';
import { homeNav, site } from '../content/copy';
import '../styles/home.css';
import '../styles/journal.css';
import '../styles/photos.css';
---

<Base title={site.title} description={site.description} path="/" page="home">
  <Header links={homeNav} home="#top" identity dayChip />
  <main id="main" tabindex="-1">
    <Cover />
    <Days />
    <Photos />
    <Note />
    <Future />
    <MemoryEntry />
    <Letter />
  </main>
  <Footer grand />
  <Lightbox />
  <script src="../app/home.ts"></script>
</Base>
