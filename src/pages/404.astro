---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import { ArrowRight } from 'lucide';
import { common, lost } from '../content/copy';
---

<Base title="这一页不见了 · loveuhqq" description="这一页不见了。" path="/404" page="lost">
  <Header session={false} />
  <main id="main" class="lost" tabindex="-1">
    <canvas class="aura aura-lost" data-aura="lost" aria-hidden="true"></canvas>
    <div class="wrap lost-inner">
      <p class="lost-code numeral" aria-hidden="true">404</p>
      <h1 class="lost-title display" data-split>{lost.title}</h1>
      <p class="lede" data-reveal>{lost.lede}</p>
      <p data-reveal><a class="btn btn-solid" href="/" data-magnetic>{common.backToJournal} <Icon icon={ArrowRight} size={16} class="icon-nudge" /></a></p>
    </div>
  </main>
  <style>
    .lost { position: relative; display: grid; align-items: center; min-height: 100svh; overflow: hidden; isolation: isolate; }
    .aura-lost { z-index: -1; }
    .lost-inner { display: grid; justify-items: start; gap: 1.75rem; padding-block: calc(var(--header-h) + 3rem) 4rem; }
    .lost-code { font-size: clamp(7rem, 3rem + 22vw, 24rem); line-height: .8; color: transparent; -webkit-text-stroke: 1px var(--rouge); opacity: .55; }
    .lost-title { font-size: var(--step-5); line-height: 1.15; }
  </style>
  <script>
    import { mountAura } from '../motion/aura';
    const canvas = document.querySelector<HTMLCanvasElement>('[data-aura="lost"]');
    if (canvas) mountAura(canvas, { anchor: [.5, .55], follow: .3, intensity: .7, spread: 1.3 });
  </script>
</Base>
