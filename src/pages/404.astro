---
import Page from '../layouts/Page.astro';
import SiteHeader from '../components/SiteHeader.astro';
---

<Page title="这一页不见了 · loveuhqq" description="这一页不见了。" path="/404" bodyClass="lost-page">
  <SiteHeader />
  <main class="lost" id="main" tabindex="-1">
    <div class="sheet lost-sheet" data-reveal>
      <span class="tape tape-pink" aria-hidden="true"></span>
      <p class="lost-code">404</p>
      <h1>这一页，好像被撕掉了。</h1>
      <p>地址可能写错了，回日记里看看吧。</p>
      <a class="pill-link" href="/">回到日记 <span aria-hidden="true">→</span></a>
    </div>
  </main>
</Page>
