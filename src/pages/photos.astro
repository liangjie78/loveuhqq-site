---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import Lightbox from '../components/Lightbox.astro';
import PhotoSlots from '../components/PhotoSlots.astro';
import PhotosLocked from '../components/PhotosLocked.astro';
import { ArrowUpRight, ImagePlus } from 'lucide';
import '../styles/photos.css';
---

<Base title="相册 · loveuhqq" description="loveuhqq 的相册。" path="/photos/" page="album">
  <Header backHref="/#photos" />
  <main id="main" tabindex="-1" class="wrap">
    <header class="album-head">
      <h1 class="album-title display" data-split>相册</h1>
      <div class="album-aside">
        <p class="album-summary" data-photos-summary data-reveal>解锁后，才能翻开这本相册。</p>
        <p data-reveal><a class="link" href="/memories/">翻开共同回忆册 <Icon icon={ArrowUpRight} size={16} /></a></p>
      </div>
    </header>
    <div class="album-locked"><PhotosLocked /></div>
    <div class="album-status" data-needs-js>
      <p class="status-line" data-photos-status role="status" hidden></p>
      <button class="btn btn-sm" type="button" data-photos-retry hidden>再试一次</button>
    </div>
    <div class="wall is-placeholder" data-photo-wall="all">
      <PhotoSlots count={6} />
    </div>
  </main>
  <Footer backHref="/#photos" />

  <dialog class="sheet-dialog" data-paste-photo aria-labelledby="paste-photo-title">
    <div class="sheet-dialog-body">
      <h2 id="paste-photo-title">贴一张照片</h2>
      <form class="stack" data-paste-form novalidate>
        <input type="file" accept="image/*" data-paste-file hidden />
        <button class="paste-pick" type="button" data-paste-pick>
          <span class="paste-pick-empty" data-paste-empty><Icon icon={ImagePlus} size={28} />点这里选一张图</span>
          <img data-paste-preview alt="" hidden />
        </button>
        <button class="btn btn-sm paste-swap" type="button" data-paste-swap hidden>换一张</button>
        <label class="field">
          <span>标题</span>
          <input class="input" type="text" name="title" maxlength="80" placeholder="给这张写个名字" data-paste-title autocomplete="off" required />
        </label>
        <label class="field">
          <span>拍摄日期（可选）</span>
          <input class="input" type="date" name="date" data-paste-date />
        </label>
        <p class="form-error" data-paste-error role="status" hidden></p>
        <div class="dialog-actions">
          <button class="btn" type="button" data-paste-cancel>取消</button>
          <button class="btn btn-solid" type="submit" data-paste-submit>贴上</button>
        </div>
      </form>
    </div>
  </dialog>

  <dialog class="sheet-dialog" data-photo-manage aria-label="相册里的照片">
    <div class="sheet-dialog-body">
      <section class="stack" data-photo-edit-panel hidden>
        <h2 id="photo-manage-title">改标题</h2>
        <form class="stack" data-photo-title-form novalidate>
          <label class="field">
            <span>给这张换个名字</span>
            <input class="input" type="text" maxlength="80" data-photo-title-input autocomplete="off" required />
          </label>
          <p class="form-error" data-photo-edit-error role="status" hidden></p>
          <div class="dialog-actions">
            <button class="btn" type="button" data-photo-manage-cancel>先不改</button>
            <button class="btn btn-solid" type="submit" data-photo-title-submit>收好标题</button>
          </div>
        </form>
      </section>
      <section class="stack" data-photo-delete-panel hidden>
        <h2>从相册取下</h2>
        <p data-photo-delete-copy></p>
        <p class="form-error" data-photo-delete-error role="status" hidden></p>
        <div class="dialog-actions">
          <button class="btn" type="button" data-photo-manage-cancel>再留一会儿</button>
          <button class="btn btn-danger" type="button" data-photo-delete-confirm>确认取下</button>
        </div>
      </section>
    </div>
  </dialog>
  <Lightbox />
  <script src="../app/photos.ts"></script>
</Base>
