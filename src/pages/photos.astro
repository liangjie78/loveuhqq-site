---
import Page from '../layouts/Page.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Lightbox from '../components/Lightbox.astro';
import { getPhotoSummary, photoStatusLabels, photos } from '../data/photos';
---

<Page title="相册 · loveuhqq" description="loveuhqq 的相册。" path="/photos/" bodyClass="album-page">
  <SiteHeader />
  <main class="album" id="main" tabindex="-1">
    <header class="album-head" data-reveal>
      <h1>相册</h1>
      <p>{getPhotoSummary(photos)}</p>
    </header>
    <div class="album-wall" data-reveal>
      {photos.map((photo, index) => (
        <a
          class="polaroid"
          href={photo.src}
          data-photo-index={index}
          aria-label={`${photo.title}（${photoStatusLabels[photo.status]}），查看大图`}
        >
          <span class:list={['tape', index % 3 === 1 && 'tape-pink']} aria-hidden="true"></span>
          <img src={photo.src} alt={photo.alt} width="800" height="1000" loading="lazy" decoding="async" />
          <span class="polaroid-caption">
            <span class="polaroid-title">{photo.title}</span>
            <span class="polaroid-tag">{photoStatusLabels[photo.status]}</span>
          </span>
        </a>
      ))}
      <div class="polaroid polaroid-empty" aria-hidden="true">
        <span class="polaroid-slot"><span>留给下一张</span></span>
        <span class="polaroid-caption"><span class="polaroid-title">&nbsp;</span></span>
      </div>
    </div>
  </main>
  <footer class="site-footer site-footer-small">
    <div class="footer-meta">
      <a class="text-button" href="/#photos"><span aria-hidden="true">←</span> 回到日记</a>
      <button class="text-button" type="button" data-lock-site>上锁</button>
    </div>
  </footer>
  <Lightbox />
</Page>
