---
import { getPhotoSummary, photoStatusLabels, photos } from '../data/photos';
import PassphraseGate from '../components/PassphraseGate.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content="loveuhqq 的照片相册。" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f8edf1" />

    <!-- Open Graph -->
    <meta property="og:title" content="照片相册 · loveuhqq" />
    <meta property="og:description" content="loveuhqq 的照片相册。" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://loveuhqq.x23.shop/photos/" />
    <meta property="og:image" content="https://loveuhqq.x23.shop/images/paper-heart.webp" />
    <meta property="og:locale" content="zh_CN" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="照片相册 · loveuhqq" />
    <meta name="twitter:description" content="loveuhqq 的照片相册。" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="canonical" href="https://loveuhqq.x23.shop/photos/" />

    <title>照片相册 · loveuhqq</title>

    <!-- 结构化数据 -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "ImageGallery",
        "name": "照片相册",
        "description": "loveuhqq 的照片相册",
        "url": "https://loveuhqq.x23.shop/photos/",
        "inLanguage": "zh-CN"
      }
    </script>
    <script is:inline>
      try {
        const k = 'loveuhqq_auth';
        if (localStorage.getItem(k) !== 'unlocked' && sessionStorage.getItem(k) !== 'unlocked') {
          document.documentElement.classList.add('is-locked');
        }
      } catch (e) {}
    </script>
  </head>
  <body class="album-page">
    <a class="skip-link" href="#album-main">跳到正文</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="wordmark" href="/#home" aria-label="loveuhqq 回到首页"><span class="brand-mark" aria-hidden="true">lq.</span><span>loveuhqq</span></a>
        <a class="album-return" href="/#photos">← 返回</a>
      </div>
    </header>
    <main class="album-main" id="album-main">
      <div class="album-heading">
        <p class="eyebrow">PHOTOS</p>
        <h1>照片相册</h1>
        <p class="section-description">{getPhotoSummary(photos)}</p>
      </div>
      {photos.length > 0 ? <div class="album-grid">
        {photos.map((photo, index) => <a class="album-photo" id={'photo-' + (index + 1)} href={photo.src} aria-label={'查看原图：' + photo.title + '（' + photoStatusLabels[photo.status] + '）'}><img src={photo.src} alt={photo.alt} width="800" height="1000" loading="lazy" decoding="async" /><span>{photoStatusLabels[photo.status]} · {photo.title}</span></a>)}
      </div> : <div class="album-empty"><p>照片待添加</p></div>}
    </main>
    <PassphraseGate />
    <script src="../scripts/micro-interactions.ts"></script>
  </body>
</html>
