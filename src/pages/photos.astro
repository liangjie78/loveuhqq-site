---
import Page from '../layouts/Page.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Lightbox from '../components/Lightbox.astro';
import PolaroidCard from '../components/PolaroidCard.astro';
import { getPhotoSummary, photos } from '../data/photos';
import '../styles/album-transition.css';
---

<Page title="相册 · loveuhqq" description="loveuhqq 的相册。" path="/photos/" bodyClass="album-page">
  <SiteHeader />
  <main class="album" id="main" tabindex="-1">
    <header class="album-head" data-reveal>
      <h1>相册</h1>
      <p>{getPhotoSummary(photos)}</p>
    </header>
    <div class="album-wall" data-reveal>
      {photos.map((photo, index) => (
        <PolaroidCard photo={photo} index={index} pink={index % 3 === 1} />
      ))}
      <div class="polaroid polaroid-empty" aria-hidden="true">
        <span class="polaroid-slot"><span>留给下一张</span></span>
        <span class="polaroid-caption"><span class="polaroid-title">&nbsp;</span></span>
      </div>
    </div>
  </main>
  <footer class="site-footer site-footer-small">
    <div class="footer-meta">
      <a class="text-button" href="/#photos"><span aria-hidden="true">←</span> 回到日记</a>
      <button class="text-button" type="button" data-lock-site>上锁</button>
    </div>
  </footer>
  <Lightbox />
</Page>
