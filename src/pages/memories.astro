---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import MemoryIndex from '../components/MemoryIndex.astro';
import { ArrowRight, Download, LockKeyhole, Pause, Play, RotateCcw, ChevronLeft, ChevronRight } from 'lucide';
import { common, memoryBook, memoryChapters } from '../content/copy';
import '../styles/photos.css';
import '../styles/memories.css';

const links = memoryChapters.map(({ id, nav }) => ({ href: `#${id}`, label: nav }));
const heads = Object.fromEntries(memoryChapters.map((item, index) => [item.id, { ...item, number: String(index + 1).padStart(2, '0') }]));
const newButtons: Record<string, { attr: string; label: string }> = {
  stories: { attr: 'data-story-new', label: '写一篇故事' },
  'post-office': { attr: 'data-letter-new', label: '写一封信' },
  places: { attr: 'data-place-new', label: '记一个地方' },
};
---

<Base title="共同回忆册 · loveuhqq" description="把写下的日子，收进共同回忆册。" path="/memories/" page="memories">
  <Header links={links} home="/" backHref="/#memories" />
  <main id="main" class="book" data-memory-private tabindex="-1">
    <section class="book-cover" id="top" aria-labelledby="book-title">
      <canvas class="aura aura-book" data-aura="book" aria-hidden="true"></canvas>
      <div class="wrap book-cover-grid">
        <div class="book-cover-words">
          <p class="eyebrow" data-reveal>{memoryBook.eyebrow}</p>
          <h1 class="book-title display" id="book-title" data-split>{memoryBook.title}</h1>
          <p class="lede" data-reveal>{memoryBook.lede}</p>

          <div class="lock-card" data-memory-locked data-reveal>
            <p><Icon icon={LockKeyhole} size={18} /> {memoryBook.locked}</p>
            <button class="btn btn-solid" type="button" data-open-login data-needs-js>{common.unlock}</button>
            <noscript><p>{common.noscriptUnlock}</p></noscript>
          </div>

          <div class="identity-bar" data-memory-identity hidden>
            <span>当前身份：<strong class="serif" data-current-identity></strong></span>
            <button type="button" class="btn btn-sm" data-switch-identity>换成</button>
          </div>

          <div class="identity-card sheet" data-memory-identity-unselected hidden>
            <p class="serif">请选择身份</p>
            <div class="identity-card-options">
              <button type="button" class="btn btn-solid" data-select-identity="one">男生</button>
              <button type="button" class="btn btn-solid" data-select-identity="two">女生</button>
            </div>
          </div>

          <div class="export" data-needs-member hidden>
            <button type="button" class="btn btn-sm" data-memory-export><Icon icon={Download} size={15} /> 导出当前可见记录（JSON）</button>
            <p class="meta">仅导出已保存且当前可见的回忆册记录，不包含日记、照片和音频文件。</p>
            <p class="meta" data-memory-export-status role="status"></p>
          </div>

          <p class="status-line" data-memory-status role="status" aria-live="polite"></p>
          <button class="btn btn-sm" type="button" data-memory-retry hidden>重新连接</button>
        </div>
        <MemoryIndex base="" />
      </div>
    </section>

    {['stories', 'wishes', 'post-office', 'screening', 'places', 'shared-desk'].map(id => {
      const head = heads[id];
      const action = newButtons[id];
      return (
        <section id={id} class:list={['chapter', 'book-chapter', `book-${id}`]} aria-labelledby={`${id}-title`}>
          <div class="wrap">
            <header class="book-chapter-head">
              <p class="eyebrow" data-reveal><span class="numeral">{head.number}</span>{head.note}</p>
              <h2 class="book-chapter-title display" id={`${id}-title`} tabindex="-1" data-split>{head.title}</h2>
              <p class="lede" data-reveal>{head.lede}</p>
              {id === 'post-office' && <p data-reveal><a class="link" href="/#letter">回看百日信 <Icon icon={ArrowRight} size={16} /></a></p>}
              {action && <button class="btn btn-solid book-new" type="button" {...{ [action.attr]: '' }} data-needs-member hidden>{action.label}</button>}
            </header>

            <div class="lock-card" data-section-locked>
              <p><Icon icon={LockKeyhole} size={18} /> {head.locked}</p>
              <button class="btn btn-solid" type="button" data-open-login data-needs-js>{common.unlock}</button>
              <noscript><p>{common.noscriptUnlock}</p></noscript>
            </div>

            <div class="book-body" data-section-private hidden>
              {id === 'stories' && (
                <>
                  <div class="book-filter">
                    <label class="field book-search"><span>找一找</span><input class="input" type="search" data-story-search placeholder="标题、日期或已经开放的文字" /></label>
                    <button class="btn btn-sm" type="button" data-story-filter-clear>看全部故事</button>
                  </div>
                  <p class="meta" data-story-filter-hint></p>
                  <div class="card-grid" data-story-list></div>
                  <article class="story sheet" data-story-detail hidden></article>
                  <form data-story-form class="book-form sheet" hidden>
                    <h3 class="serif" data-story-form-title>写一篇故事</h3>
                    <input name="id" type="hidden" />
                    <div class="form-row">
                      <label class="field"><span>标题</span><input class="input" name="title" maxlength="120" required /></label>
                      <label class="field"><span>日期</span><input class="input" name="date" type="date" required /></label>
                    </div>
                    <label class="field"><span>共同记下的正文</span><textarea class="textarea" name="text" rows="6" maxlength="10000"></textarea></label>
                    <label class="field"><span>这一页的排法</span><select class="select" name="layout"><option value="journal">手账</option><option value="album">照片手账</option><option value="letter">信纸</option></select></label>
                    <label class="check"><input name="revealTogether" type="checkbox" /> <span>两个人都提交后，再一起看到各自的版本</span></label>
                    <fieldset><legend>贴上已有照片</legend><div class="photo-picker" data-story-photos></div></fieldset>
                    <fieldset><legend>关联往后的愿望</legend><div class="choice-list" data-story-wishes></div></fieldset>
                    <div class="row-actions"><button class="btn btn-solid" type="submit">收好故事</button><button class="btn" type="button" data-story-cancel>先不改</button></div>
                  </form>
                </>
              )}
              {id === 'wishes' && <div class="card-grid" data-memory-wishes></div>}
              {id === 'post-office' && (
                <>
                  <div class="card-grid envelopes" data-letter-list></div>
                  <article class="post-letter sheet" data-letter-detail hidden></article>
                  <form data-letter-form class="book-form sheet" hidden>
                    <h3 class="serif">写给以后的信</h3><input name="id" type="hidden" />
                    <label class="field"><span>信封上的标题</span><input class="input" name="title" maxlength="120" required /></label>
                    <div class="form-row">
                      <label class="field"><span>收信人</span><select class="select" name="recipientId" required><option value="one">第一位</option><option value="two">第二位</option></select></label>
                      <label class="field"><span>拆信日期</span><input class="input" name="openDate" type="date" required /></label>
                    </div>
                    <label class="field"><span>一起拆信编号（选填）</span><input class="input" name="pairKey" maxlength="80" pattern="[a-zA-Z0-9-]+" placeholder="双方填同一短编号，比如 trip-2027" /></label>
                    <p class="meta">填写相同编号的两封信，都封好并到期后再一起开放。</p>
                    <label class="field"><span>正文</span><textarea class="textarea" name="text" rows="8" maxlength="16000" required></textarea></label>
                    <div class="row-actions"><button class="btn btn-solid" type="submit">保存草稿</button><button class="btn" type="button" data-letter-cancel>先不写</button></div>
                  </form>
                </>
              )}
              {id === 'screening' && (
                <div class="screening">
                  <form data-screening-form class="book-form sheet screening-pick">
                    <fieldset><legend>选择故事与照片，按下面的顺序播放</legend><div class="choice-list" data-screening-options></div></fieldset>
                    <button class="btn btn-solid" type="submit">排成一段回忆</button>
                    <ol class="screening-order" data-screening-order></ol>
                  </form>
                  <div class="screening-room">
                    <div class="screening-stage" data-screening-stage aria-live="polite" data-lenis-prevent><p>选几页真实的内容，再开始播放。</p></div>
                    <div class="screening-bar">
                      <p class="meta" data-screening-progress></p>
                      <div class="screening-controls">
                        <button class="icon-btn" type="button" data-screening-prev aria-label="上一页"><Icon icon={ChevronLeft} size={20} /><span class="sr-only">上一页</span></button>
                        <button class="btn btn-solid" type="button" data-screening-play>自动播放</button>
                        <button class="icon-btn" type="button" data-screening-next aria-label="下一页"><Icon icon={ChevronRight} size={20} /><span class="sr-only">下一页</span></button>
                        <button class="btn btn-sm btn-quiet" type="button" data-screening-restart><Icon icon={RotateCcw} size={14} /> 从头再看</button>
                      </div>
                    </div>
                  </div>
                </div>
              )}
              {id === 'places' && (
                <>
                  <label class="field book-year"><span>按年份翻看</span><select class="select" data-place-year><option value="">所有年份</option></select></label>
                  <div class="places" data-place-list></div>
                  <form data-place-form class="book-form sheet" hidden>
                    <h3 class="serif">记一个地方</h3><input name="id" type="hidden" />
                    <div class="form-row">
                      <label class="field"><span>地点名</span><input class="input" name="name" maxlength="120" required /></label>
                      <label class="field"><span>年份</span><input class="input" name="year" type="number" min="1900" max="2200" required /></label>
                    </div>
                    <div class="form-row">
                      <label class="field"><span>关联故事</span><select class="select" name="storyId" data-place-story><option value="">暂不关联</option></select></label>
                      <label class="field"><span>关联愿望</span><select class="select" name="wishId" data-place-wish><option value="">暂不关联</option></select></label>
                    </div>
                    <details class="coords"><summary>坐标（选填）</summary><p class="meta">留空也能保存，不会读取设备定位。</p><div class="form-row"><label class="field"><span>纬度</span><input class="input" name="latitude" type="number" min="-90" max="90" step="any" /></label><label class="field"><span>经度</span><input class="input" name="longitude" type="number" min="-180" max="180" step="any" /></label></div></details>
                    <div class="row-actions"><button class="btn btn-solid" type="submit">收好地点</button><button class="btn" type="button" data-place-cancel>先不记</button></div>
                  </form>
                </>
              )}
              {id === 'shared-desk' && <div class="desk-root" data-shared-desktop></div>}
            </div>
          </div>
        </section>
      );
    })}
  </main>
  <Footer backHref="/#memories" lockLabel="合上回忆册并上锁" />
  <script src="../app/memories.ts"></script>
</Base>
