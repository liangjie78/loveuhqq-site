---
import Page from '../layouts/Page.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/memory-book.css';
import '../styles/memory-tools.css';

const navLinks = [
  { href: '#stories', label: '故事' },
  { href: '#wishes', label: '往后' },
  { href: '#post-office', label: '邮局' },
  { href: '#screening', label: '放映' },
  { href: '#places', label: '地点' },
  { href: '#shared-desk', label: '桌面' },
];

const contents = [
  { href: '#stories', title: '我们的故事', note: '把经历收成一页' },
  { href: '#wishes', title: '往后与后来', note: '从想一起做，到一起做过' },
  { href: '#post-office', title: '未来邮局', note: '留到约好的日子' },
  { href: '#screening', title: '回忆放映室', note: '慢慢翻，也可以放着看' },
  { href: '#places', title: '地点备忘', note: '以后再慢慢记' },
  { href: '#shared-desk', title: '共同桌面', note: '一起摆一摆' },
];
---

<Page title="共同回忆册 · loveuhqq" description="把写下的日子，收进共同回忆册。" path="/memories/" bodyClass="memory-page">
  <SiteHeader navLinks={navLinks} backHref="/#memories" />
  <main id="main" class="memory-main" data-memory-private tabindex="-1">
    <!-- Opening Hero -->
    <section class="hero memory-hero" id="top" aria-labelledby="memory-hero-title">
      <div class="hero-inner memory-hero-inner">
        <div class="memory-hero-words" data-reveal>
          <p class="paper-label">写下来，再一起翻看</p>
          <h1 class="memory-hero-title" id="memory-hero-title">共同回忆册</h1>
          <p class="memory-hero-desc">日子、照片和往后的想法，都可以在这里接着写。</p>

          <div class="memory-locked-card sheet" data-memory-locked>
            <span class="tape tape-corner" aria-hidden="true"></span>
            <p>解锁后，才能翻开我们的回忆册。</p>
            <button class="pencil-button" type="button" data-open-login data-needs-js>解锁手账</button>
            <noscript><p>开启 JavaScript 后才能解锁。</p></noscript>
          </div>

          <div class="memory-identity-bar" data-memory-identity hidden>
            <span>当前身份：<strong data-current-identity></strong></span>
            <button type="button" class="text-button" data-switch-identity>换成</button>
          </div>

          <div class="memory-unselected-card sheet" data-memory-identity-unselected hidden>
            <span class="tape tape-corner" aria-hidden="true"></span>
            <p>请选择身份</p>
            <div class="signature-options">
              <button type="button" class="pencil-button" data-select-identity="one">男生</button>
              <button type="button" class="pencil-button" data-select-identity="two">女生</button>
            </div>
          </div>

          <p class="memory-status" data-memory-status role="status" aria-live="polite"></p>
          <button class="text-button" type="button" data-memory-retry hidden>重新连接</button>
        </div>

        <nav class="memory-hero-contents sheet memory-nav" aria-label="回忆册目录" data-reveal>
          <span class="tape tape-corner" aria-hidden="true"></span>
          <p class="contents-lead">回忆册目录</p>
          <ol class="memory-contents-list">
            {contents.map(({ href, title, note }) => (
              <li>
                <a href={href}>
                  <span class="contents-title">{title}</span>
                  <span class="contents-note">{note}</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </div>
      <a class="scroll-hint intro" href="#stories">往下翻<span aria-hidden="true"></span></a>
    </section>

    <!-- Section 1: Stories -->
    <section id="stories" class="section memory-section" aria-labelledby="stories-title">
      <div class="section-inner">
        <header class="section-head memory-section-heading" data-reveal>
          <div class="section-head-title">
            <p class="paper-label">把经历收成一页</p>
            <h2 id="stories-title">我们的故事</h2>
            <p>写下我们共同走过的经历，双方可以留下各自的版本。</p>
          </div>
          <button class="pencil-button" type="button" data-story-new data-needs-member hidden>写一篇故事</button>
        </header>

        <div class="memory-section-locked sheet" data-section-locked>
          <span class="tape tape-corner" aria-hidden="true"></span>
          <p>解锁后，才能翻开我们的故事。</p>
          <button class="pencil-button" type="button" data-open-login data-needs-js>解锁手账</button>
          <noscript><p>开启 JavaScript 后才能解锁。</p></noscript>
        </div>

        <div class="memory-section-content" data-section-private hidden>
          <div class="memory-filter">
            <label>找一找<input type="search" data-story-search placeholder="标题、日期或已经开放的文字" /></label>
            <button class="text-button" type="button" data-story-filter-clear>看全部故事</button>
          </div>
          <p data-story-filter-hint></p>
          <div class="memory-story-list" data-story-list></div>
          <article class="memory-story paper-card sheet" data-story-detail hidden></article>
          <form data-story-form class="memory-form paper-card sheet" hidden>
            <span class="tape tape-corner" aria-hidden="true"></span>
            <h3 data-story-form-title>写一篇故事</h3>
            <input name="id" type="hidden" />
            <label>标题<input name="title" maxlength="120" required /></label>
            <label>日期<input name="date" type="date" required /></label>
            <label>共同记下的正文<textarea name="text" rows="6" maxlength="10000"></textarea></label>
            <label>这一页的排法<select name="layout"><option value="journal">手账</option><option value="album">照片手账</option><option value="letter">信纸</option></select></label>
            <label class="memory-check"><input name="revealTogether" type="checkbox" /> 两个人都提交后，再一起看到各自的版本</label>
            <fieldset><legend>贴上已有照片</legend><div class="memory-photo-picker" data-story-photos></div></fieldset>
            <fieldset><legend>关联往后的愿望</legend><div data-story-wishes></div></fieldset>
            <div class="paper-actions"><button class="pencil-button" type="submit">收好故事</button><button class="text-button" type="button" data-story-cancel>先不改</button></div>
          </form>
        </div>
      </div>
    </section>

    <!-- Section 2: Wishes -->
    <section id="wishes" class="section memory-section" aria-labelledby="memory-wishes-title">
      <div class="section-inner">
        <header class="section-head memory-section-heading" data-reveal>
          <div class="section-head-title">
            <p class="paper-label">从想一起做，到一起做过</p>
            <h2 id="memory-wishes-title">往后与后来</h2>
            <p>可以先商定日期，做过以后，再把故事收在旁边。</p>
          </div>
        </header>

        <div class="memory-section-locked sheet" data-section-locked>
          <span class="tape tape-corner" aria-hidden="true"></span>
          <p>解锁后，翻看往后与后来的记录。</p>
          <button class="pencil-button" type="button" data-open-login data-needs-js>解锁手账</button>
          <noscript><p>开启 JavaScript 后才能解锁。</p></noscript>
        </div>

        <div class="memory-section-content" data-section-private hidden>
          <div data-memory-wishes class="memory-wishes"></div>
        </div>
      </div>
    </section>

    <!-- Section 3: Post Office -->
    <section id="post-office" class="section memory-section" aria-labelledby="post-title">
      <div class="section-inner">
        <header class="section-head memory-section-heading" data-reveal>
          <div class="section-head-title">
            <p class="paper-label">留到约好的日子</p>
            <h2 id="post-title">未来邮局</h2>
            <p>封好后不能改正文。拆信日期按北京时间计算，到日子再来翻开。</p>
            <p class="memory-sublink"><a class="text-link" href="/#letter">回看百日信 →</a></p>
          </div>
          <button class="pencil-button" type="button" data-letter-new data-needs-member hidden>写一封信</button>
        </header>

        <div class="memory-section-locked sheet" data-section-locked>
          <span class="tape tape-corner" aria-hidden="true"></span>
          <p>解锁后，才能翻开未来邮局的信件。</p>
          <button class="pencil-button" type="button" data-open-login data-needs-js>解锁手账</button>
          <noscript><p>开启 JavaScript 后才能解锁。</p></noscript>
        </div>

        <div class="memory-section-content" data-section-private hidden>
          <div data-letter-list class="memory-letter-list"></div>
          <article data-letter-detail class="paper-card sheet memory-letter" hidden></article>
          <form data-letter-form class="memory-form paper-card sheet" hidden>
            <span class="tape tape-corner" aria-hidden="true"></span>
            <h3>写给以后的信</h3><input name="id" type="hidden" />
            <label>信封上的标题<input name="title" maxlength="120" required /></label>
            <label>收信人<select name="recipientId" required><option value="one">第一位</option><option value="two">第二位</option></select></label>
            <label>拆信日期<input name="openDate" type="date" required /></label>
            <label>一起拆信编号（选填）<input name="pairKey" maxlength="80" pattern="[a-zA-Z0-9-]+" placeholder="双方填同一短编号，比如 trip-2027" /></label>
            <p class="memory-meta">填写相同编号的两封信，都封好并到期后再一起开放。</p>
            <label>正文<textarea name="text" rows="8" maxlength="16000" required></textarea></label>
            <div class="paper-actions"><button class="pencil-button" type="submit">保存草稿</button><button class="text-button" type="button" data-letter-cancel>先不写</button></div>
          </form>
        </div>
      </div>
    </section>

    <!-- Section 4: Screening Room -->
    <section id="screening" class="section memory-section" aria-labelledby="screening-title">
      <div class="section-inner">
        <header class="section-head memory-section-heading" data-reveal>
          <div class="section-head-title">
            <p class="paper-label">慢慢翻，也可以放着看</p>
            <h2 id="screening-title">回忆放映室</h2>
            <p>选择故事与照片，按顺序排成一段回忆，慢慢翻，也可以放着看。</p>
          </div>
        </header>

        <div class="memory-section-locked sheet" data-section-locked>
          <span class="tape tape-corner" aria-hidden="true"></span>
          <p>解锁后，开启回忆放映室。</p>
          <button class="pencil-button" type="button" data-open-login data-needs-js>解锁手账</button>
          <noscript><p>开启 JavaScript 后才能解锁。</p></noscript>
        </div>

        <div class="memory-section-content" data-section-private hidden>
          <form data-screening-form class="memory-form paper-card sheet">
            <span class="tape tape-corner" aria-hidden="true"></span>
            <fieldset><legend>选择故事与照片，按下面的顺序播放</legend><div data-screening-options class="memory-screening-options"></div></fieldset>
            <button class="pencil-button" type="submit">排成一段回忆</button>
          </form>
          <ol data-screening-order class="memory-screening-order"></ol>
          <div data-screening-stage class="memory-screening-stage paper-card sheet" aria-live="polite"><p>选几页真实的内容，再开始播放。</p></div>
          <p data-screening-progress class="memory-screening-progress"></p>
          <div class="paper-actions"><button class="text-button" type="button" data-screening-prev>上一页</button><button class="pencil-button" type="button" data-screening-play>自动播放</button><button class="text-button" type="button" data-screening-next>下一页</button><button class="text-button" type="button" data-screening-restart>从头再看</button></div>
        </div>
      </div>
    </section>

    <!-- Section 5: Places -->
    <section id="places" class="section memory-section" aria-labelledby="places-title">
      <div class="section-inner">
        <header class="section-head memory-section-heading" data-reveal>
          <div class="section-head-title">
            <p class="paper-label">以后再慢慢记</p>
            <h2 id="places-title">地点备忘</h2>
            <p>先留一个地点名，想好后再关联故事或愿望。不用填写坐标。</p>
          </div>
          <button class="pencil-button" type="button" data-place-new data-needs-member hidden>记一个地方</button>
        </header>

        <div class="memory-section-locked sheet" data-section-locked>
          <span class="tape tape-corner" aria-hidden="true"></span>
          <p>解锁后，翻看地点备忘。</p>
          <button class="pencil-button" type="button" data-open-login data-needs-js>解锁手账</button>
          <noscript><p>开启 JavaScript 后才能解锁。</p></noscript>
        </div>

        <div class="memory-section-content" data-section-private hidden>
          <label class="memory-year-filter">按年份翻看<select data-place-year><option value="">所有年份</option></select></label>
          <div data-place-list class="memory-place-list"></div>
          <form data-place-form class="memory-form paper-card sheet" hidden>
            <span class="tape tape-corner" aria-hidden="true"></span>
            <h3>记一个地方</h3><input name="id" type="hidden" />
            <label>地点名<input name="name" maxlength="120" required /></label><label>年份<input name="year" type="number" min="1900" max="2200" required /></label>
            <label>关联故事<select name="storyId" data-place-story><option value="">暂不关联</option></select></label><label>关联愿望<select name="wishId" data-place-wish><option value="">暂不关联</option></select></label>
            <details><summary>坐标（选填）</summary><p>留空也能保存，不会读取设备定位。</p><div class="memory-coordinates"><label>纬度<input name="latitude" type="number" min="-90" max="90" step="any" /></label><label>经度<input name="longitude" type="number" min="-180" max="180" step="any" /></label></div></details>
            <div class="paper-actions"><button class="pencil-button" type="submit">收好地点</button><button class="text-button" type="button" data-place-cancel>先不记</button></div>
          </form>
        </div>
      </div>
    </section>

    <!-- Section 6: Shared Desk -->
    <section id="shared-desk" class="section memory-section memory-desk-section" aria-labelledby="desk-title">
      <div class="section-inner">
        <header class="section-head memory-section-heading" data-reveal>
          <div class="section-head-title">
            <p class="paper-label">一起摆一摆</p>
            <h2 id="desk-title">共同桌面</h2>
            <p>桌上摆着照片、便签和票根，两个人可以一起翻看和摆放。</p>
          </div>
        </header>

        <div class="memory-section-locked sheet" data-section-locked>
          <span class="tape tape-corner" aria-hidden="true"></span>
          <p>解锁后，打开共同桌面。</p>
          <button class="pencil-button" type="button" data-open-login data-needs-js>解锁手账</button>
          <noscript><p>开启 JavaScript 后才能解锁。</p></noscript>
        </div>

        <div class="memory-section-content" data-section-private hidden>
          <div data-shared-desktop></div>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer site-footer-small">
    <div class="footer-meta">
      <a class="text-button" href="/#memories"><span aria-hidden="true">←</span> 回到日记</a>
      <button class="text-button" type="button" data-lock-site>合上回忆册并上锁</button>
    </div>
  </footer>

  <script src="../scripts/memory-book.ts"></script>
</Page>
