{
  "name": "loveuhqq-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "subset:font": "node scripts/subset-font.mjs",
    "build": "astro build",
    "check:worker": "tsc -p tsconfig.worker.json",
    "check:frontend": "tsc -p tsconfig.frontend.json",
    "photos:prepare": "node scripts/prepare-photos.mjs",
    "photos:upload:preview": "node scripts/upload-photos.mjs --config wrangler.preview.jsonc",
    "photos:upload:production": "node scripts/check-production-config.mjs && node scripts/upload-photos.mjs --config wrangler.jsonc",
    "letter:check": "node scripts/upload-letter.mjs --config wrangler.preview.jsonc --check",
    "letter:upload:preview": "node scripts/upload-letter.mjs --config wrangler.preview.jsonc",
    "letter:upload:production": "node scripts/check-production-config.mjs && node scripts/upload-letter.mjs --config wrangler.jsonc",
    "password:preview": "node scripts/set-editor-password.mjs --config wrangler.preview.jsonc",
    "password:production": "node scripts/set-editor-password.mjs --config wrangler.jsonc",
    "preview": "astro preview",
    "deploy:preview": "npm run build && wrangler deploy --config wrangler.preview.jsonc",
    "deploy": "node scripts/check-production-config.mjs && npm run build && wrangler deploy",
    "photos:upload:local": "node scripts/upload-photos.mjs --config wrangler.preview.jsonc --local"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "input-otp": "^1.5.0",
    "lucide": "^1.60.0",
    "lucide-react": "^1.60.0",
    "motion": "^14.4.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "sharp": "0.35.5",
    "subset-font": "^2.9.0",
    "terser": "^5.51.2",
    "typescript": "7.0.2",
    "wrangler": "4.149.0"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.6.5"
  }
}
