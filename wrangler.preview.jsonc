{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "loveuhqq-site-preview",
  "account_id": "a8baff96e8cfcc965098997737826969",
  "compatibility_date": "2026-09-12",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "loveuhqq-notebook-preview",
      "database_id": "1172b520-9bfe-451c-adca-12f09605f697"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "loveuhqq-photos-preview"
    }
  ],
  "main": "worker/index.ts",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
